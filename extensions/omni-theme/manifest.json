{
  "manifest_version": 3,
  "name": "Omni Theme",
  "version": "1.0.0",
  "description": "Глобальная тема The Omniscience через CSS-цветовую арифметику",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omni Theme"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "css": ["base.css"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
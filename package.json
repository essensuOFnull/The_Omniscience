{
  "name": "The_Omniscience",
  "version": "12.0.0",
  "description": "Cross-platform launcher for Omniscience apps",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64 && node scripts/package-release.mjs win",
    "build:linux": "electron-builder --linux AppImage --x64 && node scripts/package-release.mjs linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lezer/highlight": "^1.2.4",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@realtimex/piper-tts-web": "^1.1.1",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/web": "^1.3.0",
    "@strudel/webaudio": "^1.3.0",
    "@sylweriusz/mcp-ai-voice": "^1.0.1",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@uiw/react-color": "^2.10.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "chonky2": "^6.5.8",
    "cross-env": "^10.1.0",
    "cross-fetch": "^4.1.0",
    "electron-chrome-extensions": "^4.9.0",
    "file-saver": "^2.0.5",
    "iconv-lite": "^0.7.3",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "jszip": "^3.10.2",
    "jzz": "^1.9.6",
    "jzz-gui-player": "^1.7.9",
    "jzz-midi-smf": "^1.9.9",
    "jzz-synth-tiny": "^1.4.4",
    "lodash": "^4.18.1",
    "motion": "^13.4.4",
    "node-web-audio-api": "^2.2.0",
    "npm-check-updates": "^23.1.0",
    "onnxruntime-web": "^1.30.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "react-frame-component": "^5.3.2",
    "styled-components": "^6.5.3",
    "three": "^0.186.1",
    "vite": "^8.3.1",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild": true,
    "scarf": true
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "org.omniscience.launcher",
    "productName": "Omniscience",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "index.mjs",
      "main/**/*",
      "public/**/*",
      "texts/**/*",
      "config.json",
      "icon.ico",
      "package.json",
      "!componentapps/**",
      "!webapps/**",
      "!extensions/**",
      "!tests/**",
      "!release/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Omniscience-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Omniscience-${version}-linux-${arch}.${ext}"
    }
  }
}

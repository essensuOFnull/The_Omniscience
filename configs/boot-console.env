# Параметры boot-консоли Omniscience.
# Данные, а не код. Меняй свободно.

BOOT_TERM_CANDIDATES="uxterm xterm"
BOOT_CLASS="OmniscienceBoot"
BOOT_TITLE="The Omniscience"
BOOT_FALLBACK_WIDTH="1920"
BOOT_FALLBACK_HEIGHT="1080"
BOOT_FONT="Terminus"
BOOT_FONT_SIZE="16"
BOOT_BG="#000000"
BOOT_FG="#ffffff"
BOOT_BD="#000000"

# ─── Геометрия ───
# Размер ячейки шрифта в пикселях. Для Terminus при -fs 16 обычно 8x16.
# Если консоль получится слишком узкой/широкой — поправь.
# Проверить точно: `xterm -fa Terminus -fs 16 -report-fonts -e true 2>&1 | head`
BOOT_CELL_W="8"
BOOT_CELL_H="16"

# ─── Запуск главного приложения DE ───
# @PROJECT_ROOT@ подставляется install-session.sh во время установки.
# Вручную сюда путь не вписывай — перезапишется.
OMNISCIENCE_APP="npm start"
OMNISCIENCE_APP_CWD="@PROJECT_ROOT@"

# ─── Отладка ───
# Если 1 — перед закрытием boot-консоли сессия ждёт Enter.
# Нужно, чтобы успеть прочитать логи, когда что-то падает.
OMNISCIENCE_DEBUG_PAUSE=0

# Если 1 — писать полный лог сессии в файл.
# Файл: $SESSION_ROOT/log/session-YYYYMMDD-HHMMSS.log
OMNISCIENCE_LOG=1